{
	"name": "emailflare",
	"private": true,
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"build:email-core": "pnpm --filter @emailflare/email-core build",
		"build:inbox-core": "pnpm --filter @emailflare/inbox-core build",
		"build:emails": "pnpm --filter @emailflare/emails build",
		"build:shared": "pnpm run build:email-core && pnpm run build:inbox-core && pnpm run build:emails",
		"build:web": "pnpm --filter @emailflare/web build",
		"test": "pnpm --filter @emailflare/email-core test && pnpm --filter @emailflare/inbox-core test",
		"typecheck": "pnpm --filter '@emailflare/*' exec tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit": "pnpm audit --audit-level=high"
	},
	"devDependencies": {
		"lefthook": "^2.1.12",
		"prettier": "^3.9.6"
	}
}
