{
	"name": "emailflare",
	"private": true,
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"build": "pnpm --filter @emailflare/dashboard build",
		"build:dashboard": "pnpm --filter @emailflare/dashboard build",
		"test": "tsx --tsconfig apps/dashboard/tsconfig.json --test apps/dashboard/test/*.test.ts",
		"typecheck": "pnpm --filter @emailflare/dashboard exec tsc --noEmit",
		"lint:ui": "node apps/dashboard/scripts/check-ui-tokens.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit": "pnpm audit --audit-level=high"
	},
	"devDependencies": {
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"tsx": "^4.23.15"
	}
}
