{
	"name": "emailflare",
	"private": true,
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"build": "pnpm --filter @emailflare/web build",
		"build:web": "pnpm --filter @emailflare/web build",
		"test": "tsx --test apps/web/test/*.test.ts",
		"typecheck": "pnpm --filter @emailflare/web exec tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit": "pnpm audit --audit-level=high"
	},
	"devDependencies": {
		"lefthook": "^2.1.12",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.1.2",
		"tsx": "^4.19.3"
	}
}
