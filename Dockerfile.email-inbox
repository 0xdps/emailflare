# ── Stage: build-core ─────────────────────────────────────────────────────────
# Builds the mesahub-server Go binary from source (same as root Dockerfile).
FROM golang:1.24-alpine AS build-core
RUN apk add --no-cache gcc musl-dev sqlite-dev git
ARG MESAHUB_CORE_VERSION=trunk
RUN --mount=type=secret,id=gh_token \
    git config --global url."https://$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/" && \
    git clone --depth 1 --branch ${MESAHUB_CORE_VERSION} \
    https://github.com/mesahub-db/mesahub-core.git /mesahub-core
WORKDIR /mesahub-core/server
RUN CGO_ENABLED=1 GOOS=linux go build -o /go/bin/mesahub-server ./cmd/server

# ── Stage: build-emails ────────────────────────────────────────────────────────
FROM node:22-alpine AS build-emails
WORKDIR /app/services/emails
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY services/emails/package.json ./
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    pnpm install
COPY services/emails/ ./
RUN pnpm run build

# ── Stage: build-email-core ───────────────────────────────────────────────────
FROM node:22-alpine AS build-email-core
WORKDIR /app/email-core
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY packages/email-core/package.json packages/email-core/tsconfig.json ./
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    pnpm install
COPY packages/email-core/src/ ./src/
RUN pnpm run build

# ── Stage: build-inbox-core ───────────────────────────────────────────────────
FROM node:22-alpine AS build-inbox-core
WORKDIR /app/inbox-core
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY packages/inbox-core/package.json packages/inbox-core/tsconfig.json ./
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    pnpm install
COPY packages/inbox-core/src/ ./src/
RUN pnpm run build

# ── Stage: build-inbox-server ─────────────────────────────────────────────────
FROM node:22-alpine AS build-inbox-server
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

COPY services/inbox-server/package.json services/inbox-server/pnpm-lock.yaml ./services/inbox-server/
COPY --from=build-email-core /app/email-core /app/packages/email-core
COPY --from=build-inbox-core /app/inbox-core /app/packages/inbox-core
COPY --from=build-emails /app/services/emails /app/services/emails
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    cd services/inbox-server && pnpm install

COPY services/inbox-server/ ./services/inbox-server/
RUN cd services/inbox-server && pnpm run build

# ── Stage: build-inbox-ui ──────────────────────────────────────────────────────
FROM node:22-alpine AS build-inbox-ui
WORKDIR /app/inbox-ui
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY services/inbox-ui/package.json services/inbox-ui/pnpm-lock.yaml services/inbox-ui/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY services/inbox-ui/ ./
RUN pnpm run build

# ── Stage: caddy-bin ──────────────────────────────────────────────────────────
FROM caddy:2-alpine AS caddy-bin

# ── Stage: prod ───────────────────────────────────────────────────────────────
FROM node:22-alpine AS prod
COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
RUN apk add --no-cache curl openssl
WORKDIR /app

# mesahub-server binary (embedded mode)
COPY --from=build-core /go/bin/mesahub-server /usr/local/bin/mesahub-server
RUN mkdir -p /data
VOLUME ["/data"]

# inbox-server runtime (file: deps resolved relative to services/inbox-server/, mirroring repo layout)
COPY --from=build-emails   /app/services/emails/dist           ./services/emails/dist
COPY --from=build-emails   /app/services/emails/package.json   ./services/emails/package.json
COPY --from=build-email-core /app/email-core/dist     ./packages/email-core/dist
COPY --from=build-email-core /app/email-core/package.json ./packages/email-core/package.json
COPY --from=build-inbox-core /app/inbox-core/dist     ./packages/inbox-core/dist
COPY --from=build-inbox-core /app/inbox-core/package.json ./packages/inbox-core/package.json
COPY --from=build-inbox-server /app/services/inbox-server/node_modules ./services/inbox-server/node_modules
COPY --from=build-inbox-server /app/services/inbox-server/dist          ./services/inbox-server/dist
COPY services/inbox-server/package.json                                  ./services/inbox-server/

# Migration SQL files (needed at runtime for DB init)
COPY services/inbox-worker/migrations/ ./migrations/

# Inbox UI static files
COPY --from=build-inbox-ui /app/inbox-ui/dist ./inbox-ui/dist

# Caddy config
COPY infra/Caddyfile.email-inbox /etc/caddy/Caddyfile
RUN caddy fmt --overwrite /etc/caddy/Caddyfile

# Startup script
COPY infra/start-email-inbox.sh /start-email-inbox.sh
RUN chmod +x /start-email-inbox.sh

EXPOSE 80
CMD ["/start-email-inbox.sh"]
