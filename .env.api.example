# EmailFlare · Email API
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in your values:
#   cp env-api.example .env.local
# Then start the dev stack:
#   just dev
#
# .env.local is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Caddy reverse proxy binds to on the host.
# Railway / Render inject PORT automatically — leave as-is for hosted deploys.
PORT=8090

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Both must be at least 32 characters. Generate each with:
#   openssl rand -hex 32
SESSION_SECRET=
ADMIN_TOKEN=

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Required for production email sending via the Cloudflare Email Sending API.
# Token scopes needed: Zone.Email Routing (Edit) + Account.Email Sending (Edit)
# Guide: https://emailflare.dev/cloudflare-token
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── Database (MesaHub / SQLite) ───────────────────────────────────────────────
# Embedded — MesaHub runs inside the container, data stored in a Docker volume.
MESAHUB_URL=mh://local/emailflare
# Hosted MesaHub instance (optional):
# MESAHUB_URL=mh://shs_your_api_key@api.mesahub.app/your-db-slug

# ── Test mode ─────────────────────────────────────────────────────────────────
# When true, test API keys capture email content into the in-house Test Mailbox
# instead of delivering via Cloudflare. No SMTP/Mailpit required.
ENABLE_TEST_MODE=false
