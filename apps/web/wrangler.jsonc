{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emailflare",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": ["nodejs_compat"],
	"main": "worker/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
		},
	},
	"upload_source_maps": true,

	// vinext serves the App Router. API and public send routes are handled by
	// the Hono app in worker/index.ts before the request reaches vinext.
	"assets": {
		"directory": "dist/client",
		"html_handling": "none",
		"not_found_handling": "none",
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"],
	},

	// Placeholder IDs are required so Deploy to Cloudflare can provision a
	// fresh database and rewrite this file with the real ID.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emailflare",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
		},
	],

	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "00000000000000000000000000000000",
		},
	],

	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "emailflare-attachments",
		},
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "NOTIFICATIONS",
				"class_name": "NotificationsHub",
			},
		],
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["NotificationsHub"],
		},
	],

	"queues": {
		"producers": [
			{
				"binding": "EMAIL_QUEUE",
				"queue": "emailflare-sequences",
			},
		],
		"consumers": [
			{
				"queue": "emailflare-sequences",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
			},
		],
	},

	"triggers": {
		"crons": ["*/5 * * * *"],
	},

	"vars": {
		"PUBLIC_URL": "https://emailflare.workers.dev",
		"INBOX_WORKER_NAME": "emailflare",
	},

	// Workers Rate Limiting (100 req / 60s per API key). Requires Workers Paid.
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": {
					"limit": 100,
					"period": 60,
				},
			},
		],
	},
}
