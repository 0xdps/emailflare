---
import { render } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { docHref, getDocs, groupDocs } from "@/lib/docs";

export async function getStaticPaths() {
	const docs = await getDocs();
	const groups = groupDocs(docs);
	// Reading order follows the sidebar: section by section.
	const flat = groups.flatMap((g) => g.items);

	return docs.map((entry) => {
		const i = flat.findIndex((item) => item.href === docHref(entry.id));
		return {
			params: { slug: entry.id },
			props: { entry, groups, prev: flat[i - 1], next: flat[i + 1] },
		};
	});
}

const { entry, groups, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	section={entry.data.section}
	id={entry.id}
	groups={groups}
	headings={headings}
	prev={prev}
	next={next}
>
	<Content />
</DocsLayout>
