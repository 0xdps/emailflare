	<script is:inline>
		// Sidebar active-link tracking
		(function () {
			const nav = document.querySelector(".docs-sidebar .sidebar-nav");
			if (!nav) return;

			const links = Array.from(nav.querySelectorAll('a[href^="#"]'));
			const ids = links.map((l) => l.getAttribute("href").slice(1));

			function update() {
				const scrollY = window.scrollY + 120;
				let active = ids[0];
				for (const id of ids) {
					const el = document.getElementById(id);
					if (el && el.getBoundingClientRect().top + window.scrollY <= scrollY) {
						active = id;
					}
				}
				links.forEach((l) => {
					l.classList.toggle("active", l.getAttribute("href") === "#" + active);
				});
			}

			window.addEventListener("scroll", update, { passive: true });
			update();
		})();
	</script>

	<script>
		(() => {
			const links = document.querySelectorAll(".inbox-product-subnav .psn-link");
			const sectionIds = ["overview", "features", "deploy"];
			const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean);

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							const id = entry.target.id;
							links.forEach((l) => {
								l.classList.toggle("active", l.getAttribute("href") === "#" + id);
							});
						}
					});
				},
				{ rootMargin: "-15% 0px -70% 0px", threshold: 0 },
			);

			sections.forEach((s) => observer.observe(s));
		})();
	</script>
