---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
---

<Base
	title="Inbox — Self-hosted email CRM on Cloudflare Workers"
	description="EmailFlare Inbox is a self-hosted CRM inbox built on a Cloudflare Worker. Every inbound email lands in a clean contact thread with sequences, real-time push, and a polished dashboard — deployed with one command."
	keywords="emailflare inbox, self-hosted crm inbox, cloudflare workers email crm, inbound email cloudflare, email sequences worker, email thread management"
	canonical="https://emailflare.dev/inbox"
	ogUrl="https://emailflare.dev/inbox"
	ogType="article"
	navType="docs"
	navTitle="Inbox"
>
	<style is:global>
		/* ── INBOX PAGE ───────────────────────────────────────────── */
		.section-eyebrow {
			color: var(--green);
		}
		.btn-primary {
			background: var(--green);
		}
		.btn-primary:hover {
			background: oklch(48% 0.18 150);
		}
		.anchor-link:hover {
			color: var(--green) !important;
		}
		.sidebar-nav li a:hover {
			border-left-color: var(--green) !important;
		}
		.sidebar-nav li a.active {
			border-left-color: var(--green) !important;
		}
		.doc-body ul li::marker {
			color: var(--green) !important;
		}
		.guide-card:hover {
			border-color: oklch(82% 0.09 150) !important;
		}
		.guide-card .gc-label {
			color: var(--green) !important;
		}
		.qs-num {
			background: oklch(95% 0.04 150) !important;
			border-color: oklch(82% 0.09 150) !important;
			color: oklch(34% 0.12 150) !important;
		}
		.callout-orange {
			background: oklch(95% 0.04 150) !important;
			border-color: oklch(82% 0.09 150) !important;
			color: oklch(34% 0.12 150) !important;
		}
		.doc-body td:first-child code {
			background: oklch(95% 0.04 150) !important;
			border-color: oklch(82% 0.09 150) !important;
			color: oklch(34% 0.12 150) !important;
		}
		.doc-body code {
			color: oklch(34% 0.12 150) !important;
		}

		/* ── HERO ─────────────────────────────────────────────────── */
		.ix-hero {
			background: oklch(11% 0.025 150);
			padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
			overflow: hidden;
			position: relative;
		}

		.ix-hero::before {
			content: "";
			position: absolute;
			inset: 0;
			background: radial-gradient(ellipse 55% 80% at 80% 50%, oklch(30% 0.1 150 / 0.25) 0%, transparent 65%);
			pointer-events: none;
		}

		.ix-hero-inner {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: clamp(2rem, 5vw, 4rem);
			align-items: center;
		}

		@media (max-width: 760px) {
			.ix-hero-inner {
				grid-template-columns: 1fr;
			}
		}

		.ix-badge {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			background: oklch(20% 0.07 150 / 0.6);
			color: oklch(76% 0.14 150);
			font-size: 12px;
			font-weight: 500;
			padding: 4px 13px;
			border-radius: 100px;
			border: 1px solid oklch(38% 0.12 150 / 0.5);
			margin-bottom: 22px;
		}

		.ix-hero h1 {
			font-family: var(--font-display);
			font-size: clamp(2rem, 4vw, 3rem);
			font-weight: 400;
			line-height: 1.1;
			letter-spacing: -0.025em;
			color: oklch(95% 0.008 58);
			margin-bottom: 18px;
		}

		.ix-hero h1 em {
			font-style: italic;
			color: var(--green);
		}

		.ix-hero-sub {
			font-size: 1rem;
			color: oklch(60% 0.01 58);
			line-height: 1.75;
			max-width: 480px;
			margin-bottom: 30px;
		}

		.ix-actions {
			display: flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
		}

		/* ── INBOX MOCK UI ───────────────────────────────────────── */
		.ix-ui-card {
			background: oklch(16% 0.02 150);
			border: 1px solid oklch(28% 0.06 150 / 0.5);
			border-radius: var(--radius-lg);
			overflow: hidden;
			box-shadow:
				0 24px 60px oklch(0% 0 0 / 0.3),
				0 0 0 1px oklch(100% 0 0 / 0.04);
		}

		.ix-ui-bar {
			background: oklch(20% 0.018 150);
			border-bottom: 1px solid oklch(28% 0.04 150 / 0.5);
			padding: 10px 16px;
			display: flex;
			align-items: center;
			gap: 7px;
		}
		.ix-dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
		}
		.ixd-r {
			background: oklch(52% 0.14 24 / 0.6);
		}
		.ixd-y {
			background: oklch(68% 0.14 80 / 0.6);
		}
		.ixd-g {
			background: oklch(56% 0.14 150 / 0.6);
		}
		.ix-bar-title {
			margin-left: 6px;
			font-size: 11px;
			color: oklch(44% 0.01 58);
			font-family: var(--font-mono);
		}

		.ix-ui-body {
			display: flex;
		}

		.ix-ui-list {
			width: 44%;
			border-right: 1px solid oklch(22% 0.02 150 / 0.7);
			padding: 8px 0;
		}

		.ix-contact-row {
			padding: 10px 14px;
			border-bottom: 1px solid oklch(20% 0.01 150 / 0.5);
			cursor: default;
			position: relative;
		}
		.ix-contact-row.ix-active {
			background: oklch(22% 0.06 150 / 0.4);
		}
		.ix-contact-row.ix-active::before {
			content: "";
			position: absolute;
			left: 0;
			top: 8px;
			bottom: 8px;
			width: 3px;
			border-radius: 0 3px 3px 0;
			background: var(--green);
		}

		.ix-row-top {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 4px;
		}
		.ix-avatar {
			width: 24px;
			height: 24px;
			border-radius: 50%;
			background: oklch(28% 0.06 150 / 0.6);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 9px;
			font-weight: 600;
			color: oklch(70% 0.1 150);
			flex-shrink: 0;
		}
		.ix-avatar.ix-unread {
			background: oklch(32% 0.1 150 / 0.7);
		}
		.ix-name {
			font-size: 11px;
			font-weight: 600;
			color: oklch(84% 0.01 58);
			flex: 1;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.ix-time {
			font-size: 9.5px;
			color: oklch(44% 0.01 58);
			font-family: var(--font-mono);
		}
		.ix-preview {
			font-size: 10px;
			color: oklch(48% 0.01 58);
			line-height: 1.5;
			padding-left: 32px;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.ix-unread-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: var(--green);
			flex-shrink: 0;
		}

		.ix-ui-thread {
			flex: 1;
			padding: 14px;
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.ix-thread-header {
			display: flex;
			align-items: center;
			gap: 10px;
			padding-bottom: 10px;
			border-bottom: 1px solid oklch(22% 0.02 150 / 0.7);
			margin-bottom: 4px;
		}

		.ix-thread-avatar {
			width: 30px;
			height: 30px;
			border-radius: 50%;
			background: oklch(30% 0.08 150 / 0.6);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 11px;
			font-weight: 700;
			color: oklch(72% 0.12 150);
			flex-shrink: 0;
		}

		.ix-thread-name {
			font-size: 12.5px;
			font-weight: 600;
			color: oklch(88% 0.01 58);
		}
		.ix-thread-sub {
			font-size: 10px;
			color: oklch(48% 0.01 58);
		}
		.ix-thread-badge {
			margin-left: auto;
			font-size: 9.5px;
			font-weight: 600;
			background: oklch(26% 0.08 150 / 0.5);
			color: oklch(68% 0.1 150);
			border: 1px solid oklch(38% 0.1 150 / 0.4);
			padding: 1px 7px;
			border-radius: 100px;
		}

		.ix-email-card {
			background: oklch(18% 0.016 150 / 0.8);
			border: 1px solid oklch(24% 0.03 150 / 0.5);
			border-radius: 7px;
			padding: 10px 12px;
		}
		.ix-email-card.ix-sent {
			background: oklch(22% 0.06 150 / 0.3);
			border-color: oklch(32% 0.08 150 / 0.4);
		}

		.ix-email-header {
			display: flex;
			align-items: center;
			gap: 7px;
			margin-bottom: 6px;
		}
		.ix-email-from-badge {
			font-size: 9.5px;
			font-weight: 600;
			padding: 1px 6px;
			border-radius: 100px;
			background: oklch(24% 0.05 150 / 0.5);
			color: oklch(62% 0.08 150);
			border: 1px solid oklch(32% 0.06 150 / 0.4);
		}
		.ix-email-card.ix-sent .ix-email-from-badge {
			background: oklch(28% 0.1 150 / 0.4);
			color: oklch(72% 0.12 150);
			border-color: oklch(42% 0.1 150 / 0.4);
		}
		.ix-email-subj {
			font-size: 10px;
			font-weight: 600;
			color: oklch(80% 0.01 58);
			flex: 1;
		}
		.ix-email-ts {
			font-size: 9px;
			color: oklch(42% 0.01 58);
			font-family: var(--font-mono);
			margin-left: auto;
		}
		.ix-email-body {
			font-size: 9.5px;
			color: oklch(55% 0.01 58);
			line-height: 1.6;
		}

		.ix-reply-bar {
			background: oklch(18% 0.018 150);
			border: 1px solid oklch(28% 0.05 150 / 0.4);
			border-radius: 7px;
			padding: 8px 12px;
			margin-top: 4px;
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 10px;
			color: oklch(38% 0.01 58);
		}

		.ix-reply-btn {
			margin-left: auto;
			background: var(--green);
			color: oklch(12% 0.02 150);
			font-size: 9.5px;
			font-weight: 600;
			padding: 3px 10px;
			border-radius: 5px;
			white-space: nowrap;
		}

		/* ── SECTION COMMONS ──────────────────────────────────────── */
		.section {
			padding: clamp(3rem, 6vw, 5rem) 0;
		}

		.section-eyebrow {
			font-size: 11.5px;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--green);
			margin-bottom: 12px;
		}

		.section-title {
			font-family: var(--font-display);
			font-size: clamp(1.875rem, 3.5vw, 2.625rem);
			font-weight: 400;
			line-height: 1.12;
			letter-spacing: -0.025em;
			color: var(--text);
			margin-bottom: 16px;
		}

		.section-title em {
			font-style: italic;
			color: var(--green);
		}

		.section-sub {
			font-size: 1rem;
			color: var(--text-muted);
			line-height: 1.72;
			max-width: 560px;
			margin-bottom: 0;
		}

		.section-header {
			margin-bottom: 44px;
		}

		/* ── FEATURES GRID ────────────────────────────────────────── */
		.ix-feat-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 14px;
		}

		@media (max-width: 820px) {
			.ix-feat-grid {
				grid-template-columns: 1fr 1fr;
			}
		}
		@media (max-width: 520px) {
			.ix-feat-grid {
				grid-template-columns: 1fr;
			}
		}

		.ix-feat-card {
			background: var(--bg-card);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 22px 22px 18px;
			transition: border-color 0.15s;
		}

		.ix-feat-card:hover {
			border-color: oklch(82% 0.09 150);
		}

		.ix-feat-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 38px;
			height: 38px;
			background: oklch(95% 0.04 150);
			border-radius: 10px;
			margin-bottom: 14px;
			color: var(--green);
		}

		.ix-feat-icon svg {
			width: 18px;
			height: 18px;
		}

		.ix-feat-card h3 {
			font-size: 0.9375rem;
			font-weight: 600;
			margin-bottom: 7px;
			letter-spacing: -0.01em;
		}
		.ix-feat-card p {
			font-size: 0.875rem;
			color: var(--text-muted);
			line-height: 1.65;
			margin: 0;
		}

		/* ── HOW IT WORKS ─────────────────────────────────────────── */
		.ix-flow-section {
			background: var(--bg-alt);
			border-top: 1px solid var(--border);
			border-bottom: 1px solid var(--border);
		}

		.ix-flow-wrap {
			display: flex;
			align-items: stretch;
			gap: 0;
			background: var(--bg-card);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			overflow: hidden;
			margin-top: 44px;
		}

		.ix-flow-step {
			flex: 1;
			padding: 24px 22px 22px;
			border-right: 1px solid var(--border);
			position: relative;
		}
		.ix-flow-step:last-child {
			border-right: none;
		}

		@media (max-width: 680px) {
			.ix-flow-wrap {
				flex-direction: column;
			}
			.ix-flow-step {
				border-right: none;
				border-bottom: 1px solid var(--border);
			}
			.ix-flow-step:last-child {
				border-bottom: none;
			}
			.ix-flow-arrow {
				display: none;
			}
		}

		.ix-flow-num {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 24px;
			height: 24px;
			border-radius: 50%;
			background: oklch(95% 0.04 150);
			border: 1.5px solid oklch(82% 0.09 150);
			font-size: 11px;
			font-weight: 700;
			color: oklch(34% 0.12 150);
			margin-bottom: 12px;
		}

		.ix-flow-step h4 {
			font-size: 0.875rem;
			font-weight: 600;
			margin-bottom: 6px;
		}
		.ix-flow-step p {
			font-size: 0.825rem;
			color: var(--text-muted);
			line-height: 1.6;
			margin: 0;
		}

		.ix-flow-tag {
			display: inline-block;
			font-size: 10px;
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			padding: 2px 9px;
			border-radius: 100px;
			margin-bottom: 10px;
		}

		.ix-tag-routing {
			background: oklch(93% 0.04 230);
			color: oklch(38% 0.14 230);
			border: 1px solid oklch(80% 0.1 230 / 0.5);
		}
		.ix-tag-worker {
			background: oklch(93% 0.04 44);
			color: oklch(38% 0.14 44);
			border: 1px solid oklch(80% 0.1 44 / 0.5);
		}
		.ix-tag-db {
			background: oklch(93% 0.04 80);
			color: oklch(38% 0.12 70);
			border: 1px solid oklch(80% 0.1 80 / 0.5);
		}
		.ix-tag-dash {
			background: oklch(95% 0.04 150);
			color: oklch(34% 0.12 150);
			border: 1px solid oklch(82% 0.09 150 / 0.5);
		}
		.ix-tag-queue {
			background: oklch(93% 0.04 290);
			color: oklch(38% 0.14 290);
			border: 1px solid oklch(80% 0.1 290 / 0.5);
		}

		/* ── DEPLOY SECTION ───────────────────────────────────────── */
		.ix-deploy-section {
			background: oklch(11% 0.025 150);
		}
		.ix-deploy-section .section-eyebrow {
			color: oklch(68% 0.12 150);
		}
		.ix-deploy-section .section-title {
			color: oklch(95% 0.006 58);
		}
		.ix-deploy-section .section-sub {
			color: oklch(56% 0.01 58);
		}

		.ix-deploy-option {
			background: oklch(14% 0.03 150 / 0.8);
			border: 1px solid oklch(28% 0.08 150 / 0.7);
			border-radius: var(--radius-lg);
			display: flex;
			flex-direction: column;
			overflow: hidden;
			margin-top: 48px;
		}
		.ix-do-header {
			padding: 24px 28px 20px;
			border-bottom: 1px solid oklch(22% 0.05 150 / 0.6);
		}
		.ix-do-badge {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			padding: 3px 10px;
			border-radius: 99px;
			margin-bottom: 14px;
			background: oklch(20% 0.08 150 / 0.5);
			color: var(--green);
			border: 1px solid oklch(36% 0.1 150 / 0.5);
		}
		.ix-do-title {
			font-size: 1.15rem;
			font-weight: 700;
			color: oklch(93% 0.01 58);
			margin-bottom: 8px;
		}
		.ix-do-sub {
			font-size: 0.875rem;
			color: oklch(56% 0.01 58);
			line-height: 1.6;
		}
		.ix-do-steps {
			padding: 20px 28px;
			flex: 1;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 16px 32px;
		}
		@media (max-width: 740px) {
			.ix-do-steps {
				grid-template-columns: 1fr;
			}
		}
		.ix-do-step {
			display: flex;
			gap: 14px;
			align-items: flex-start;
		}
		.ix-do-step-num {
			flex-shrink: 0;
			width: 22px;
			height: 22px;
			border-radius: 50%;
			border: 1px solid oklch(36% 0.1 150 / 0.6);
			font-size: 11px;
			font-weight: 700;
			color: var(--green);
			display: flex;
			align-items: center;
			justify-content: center;
			margin-top: 2px;
		}
		.ix-do-step-label {
			font-size: 13px;
			font-weight: 600;
			color: oklch(84% 0.01 58);
			margin-bottom: 6px;
		}
		.ix-do-step-desc {
			font-size: 12.5px;
			color: oklch(52% 0.01 58);
			line-height: 1.55;
			margin-bottom: 8px;
		}
		.ix-do-step-label code,
		.ix-do-step-desc code {
			font-family: var(--font-mono);
			font-size: 11px;
			background: oklch(20% 0.04 150 / 0.5);
			border: 1px solid oklch(32% 0.06 150 / 0.4);
			color: oklch(72% 0.1 150);
			padding: 1px 5px;
			border-radius: 4px;
		}
		.ix-do-footer {
			padding: 16px 28px;
			border-top: 1px solid oklch(22% 0.05 150 / 0.6);
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
		}
		.ix-do-footer-note {
			font-size: 12px;
			color: oklch(44% 0.01 58);
		}
		.ix-do-footer a {
			font-size: 13px;
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
			color: var(--green);
		}
		.ix-code-block {
			background: oklch(10% 0.02 150);
			border: 1px solid oklch(22% 0.05 150 / 0.6);
			border-radius: 8px;
			padding: 12px 14px;
			font-family: var(--font-mono);
			font-size: 11.5px;
			line-height: 1.75;
			overflow-x: auto;
			display: flex;
			flex-direction: column;
			gap: 0;
		}
		.ix-cb-cmd {
			color: oklch(76% 0.1 150);
		}
		.ix-cb-cmt {
			color: oklch(42% 0.01 58);
			font-style: italic;
		}
		.ix-cb-url {
			color: var(--green);
		}

		/* ── DOCS ─────────────────────────────────────────────────── */
		.docs-hero {
			background: oklch(14% 0.016 150);
			padding: clamp(3rem, 7vw, 5rem) 0 clamp(2rem, 4vw, 3rem);
			overflow: hidden;
		}

