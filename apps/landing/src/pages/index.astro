---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "EmailFlare",
	url: "https://emailflare.dev",
	description:
		"EmailFlare is an open-source, edge-native email engine on Cloudflare: transactional email sending API, collaborative team inbox with email routing, 50 React Email templates, and a Next.js admin dashboard in a single unified worker bundle.",
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Cloudflare Workers",
	license: "https://github.com/0xdps/emailflare/blob/trunk/LICENSE",
	codeRepository: "https://github.com/0xdps/emailflare",
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base
	title="EmailFlare — Email API & Team Inbox for Cloudflare"
	description="The complete email engine for Cloudflare. Send transactional emails via REST API, collaborate on inbound conversations with a shared team inbox, and render 50 React Email templates — all in one single deployment."
	keywords="emailflare, self-hosted email, cloudflare email sending, transactional email, open source email api, cloudflare inbox, team inbox cloudflare, email routing inbox, react email templates, nextjs cloudflare worker"
	canonical="https://emailflare.dev/"
	ogUrl="https://emailflare.dev/"
	ogType="website"
	navType="home"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</Fragment>

	<style is:global>
		/* ── HERO ─────────────────────────────────────────────────── */
		.hero {
			padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6.5rem);
			position: relative;
			overflow: hidden;
		}

		.hero::before {
			content: "";
			position: absolute;
			inset: 0;
			background: radial-gradient(ellipse 60% 70% at 72% 40%, oklch(93% 0.06 58 / 0.5) 0%, transparent 65%);
			pointer-events: none;
		}

		.hero-split {
			display: grid;
			grid-template-columns: 1fr 1.1fr;
			gap: clamp(2.5rem, 5vw, 5rem);
			align-items: center;
		}

		.hero-top-row {
			display: flex;
			align-items: center;
			gap: 10px;
			margin-bottom: 28px;
			flex-wrap: wrap;
		}

		.hero-badge {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			background: var(--orange-light);
			color: var(--orange-hover);
			font-size: 12.5px;
			font-weight: 500;
			padding: 4px 13px;
			border-radius: 100px;
			border: 1px solid var(--orange-mid);
		}

		.hero-sponsor {
			display: inline-flex;
			align-items: center;
			gap: 5px;
			background: oklch(97% 0.02 10);
			color: oklch(48% 0.2 10);
			font-size: 12.5px;
			font-weight: 500;
			padding: 4px 13px;
			border-radius: 100px;
			border: 1px solid oklch(88% 0.06 10);
			text-decoration: none;
			transition:
				background 0.15s,
				border-color 0.15s;
		}
		.hero-sponsor:hover {
			background: oklch(93% 0.04 10);
			border-color: oklch(80% 0.1 10);
		}

		.hero h1 {
			font-family: var(--font-display);
			font-size: clamp(2.5rem, 4vw, 3.6rem);
			font-weight: 400;
			line-height: 1.08;
			letter-spacing: -0.028em;
			margin: 0 0 22px;
			color: var(--text);
		}

		.hero h1 em {
			font-style: italic;
			color: var(--orange);
		}

		.hero-sub {
			font-size: clamp(0.93rem, 1.7vw, 1.04rem);
			color: var(--text-muted);
			max-width: 460px;
			margin: 0 0 34px;
			line-height: 1.72;
			font-weight: 400;
		}

		.hero-actions {
			display: flex;
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
		}

		.hero-visual {
			position: relative;
		}

		@media (max-width: 860px) {
			.hero-split {
				grid-template-columns: 1fr;
			}
			.hero h1 {
				font-size: clamp(2.3rem, 7vw, 3.1rem);
			}
			.hero-sub {
				max-width: 520px;
			}
		}

		/* ── LIVING EDGE PIPELINE (CONCEPT 3) ───────────────────────── */
		.pipeline-card {
			background: oklch(13% 0.016 48);
			border: 1px solid oklch(24% 0.02 48);
			border-radius: var(--radius-lg);
			box-shadow:
				0 24px 60px oklch(0% 0 0 / 0.35),
				0 0 0 1px oklch(100% 0 0 / 0.06),
				inset 0 1px 0 oklch(100% 0 0 / 0.06);
			overflow: hidden;
			position: relative;
			display: flex;
			flex-direction: column;
		}

		/* Ambient corner glow inside card */
		.pipeline-card::before {
			content: "";
			position: absolute;
			top: -80px;
			right: -80px;
			width: 240px;
			height: 240px;
			background: radial-gradient(circle, oklch(64% 0.19 44 / 0.18) 0%, transparent 70%);
			pointer-events: none;
			border-radius: 50%;
		}

		.pipeline-bar {
			background: oklch(16% 0.014 48);
			border-bottom: 1px solid oklch(22% 0.016 48);
			padding: 12px 18px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
		}

		.pipeline-dots {
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.p-dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			opacity: 0.85;
		}
		.p-dot-red {
			background: #ef4444;
		}
		.p-dot-yellow {
			background: #f59e0b;
		}
		.p-dot-green {
			background: #10b981;
		}

		.pipeline-title {
			display: flex;
			align-items: center;
			gap: 8px;
			font-family: var(--font-mono);
			font-size: 11.5px;
			color: oklch(75% 0.01 58);
		}

		.p-edge-badge {
			color: var(--orange);
			font-weight: 600;
		}

		.p-sep {
			color: oklch(40% 0.01 58);
		}

		.p-route {
			color: oklch(65% 0.01 58);
		}

		.pipeline-status {
			display: flex;
			align-items: center;
			gap: 6px;
			background: oklch(18% 0.02 150 / 0.6);
			border: 1px solid oklch(40% 0.1 150 / 0.4);
			padding: 3px 9px;
			border-radius: 100px;
			font-size: 11px;
			color: oklch(80% 0.12 150);
			font-family: var(--font-mono);
		}

		.live-pulse {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #10b981;
			box-shadow: 0 0 8px #10b981;
			animation: p-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
		}

		@keyframes p-pulse {
			0%,
			100% {
				opacity: 1;
				transform: scale(1);
			}
			50% {
				opacity: 0.4;
				transform: scale(0.85);
			}
		}

		.pipeline-body {
			padding: 22px 20px 20px;
			display: flex;
			flex-direction: column;
			gap: 14px;
		}

		/* Step 1: Inbound Node */
		.pipe-node {
			display: flex;
			gap: 14px;
			position: relative;
		}

		.node-badge-col {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 32px;
			flex-shrink: 0;
		}

		.node-icon {
			width: 32px;
			height: 32px;
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 14px;
			border: 1px solid oklch(28% 0.02 48);
			background: oklch(18% 0.018 48);
			color: oklch(75% 0.01 58);
			z-index: 2;
		}

		.node-icon-inbound {
			color: oklch(78% 0.14 230);
			border-color: oklch(40% 0.12 230 / 0.4);
			background: oklch(20% 0.04 230 / 0.4);
		}

		.node-icon-worker {
			color: var(--orange);
			border-color: oklch(50% 0.18 44 / 0.5);
			background: oklch(20% 0.06 44 / 0.5);
		}

		.pipe-connector-line {
			width: 2px;
			flex: 1;
			min-height: 24px;
			background: linear-gradient(to bottom, oklch(36% 0.03 48), oklch(22% 0.02 48));
			position: relative;
			overflow: hidden;
			margin: 4px 0;
		}

		.flow-particle {
			position: absolute;
			top: -20px;
			left: 0;
			width: 2px;
			height: 20px;
			background: linear-gradient(to bottom, transparent, var(--orange));
			animation: flow-down 2.2s linear infinite;
		}

		.flow-particle-delayed {
			animation-delay: 1.1s;
		}

		@keyframes flow-down {
			0% {
				top: -20px;
				opacity: 0;
			}
			30% {
				opacity: 1;
			}
			80% {
				opacity: 1;
			}
			100% {
				top: 100%;
				opacity: 0;
			}
		}

		.node-content {
			flex: 1;
			background: oklch(16% 0.014 48);
			border: 1px solid oklch(24% 0.016 48);
			border-radius: 10px;
			padding: 12px 14px;
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.node-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
		}

		.node-pill {
			font-family: var(--font-mono);
			font-size: 10px;
			font-weight: 700;
			padding: 2px 7px;
			border-radius: 4px;
			letter-spacing: 0.03em;
		}

		.pill-post {
			background: oklch(24% 0.08 230);
			color: oklch(78% 0.15 230);
			border: 1px solid oklch(40% 0.12 230 / 0.5);
		}

		.node-route {
			font-family: var(--font-mono);
			font-size: 12.5px;
			font-weight: 600;
			color: oklch(90% 0.01 58);
		}

		.node-time {
			font-family: var(--font-mono);
			font-size: 11px;
			color: oklch(75% 0.14 150);
			margin-left: auto;
		}

		.node-code-snippet {
			font-family: var(--font-mono);
			font-size: 11px;
			color: oklch(62% 0.01 58);
			background: oklch(12% 0.014 48);
			border: 1px solid oklch(20% 0.014 48);
			border-radius: 6px;
			padding: 7px 10px;
			overflow-x: auto;
			white-space: nowrap;
		}

		.nc-key {
			color: oklch(75% 0.1 230);
		}

		.nc-val {
			color: oklch(76% 0.12 140);
		}

		/* Step 2: Runtime Node Content */
		.node-content-runtime {
			border-color: oklch(34% 0.06 48);
			background: linear-gradient(180deg, oklch(17% 0.02 48) 0%, oklch(15% 0.014 48) 100%);
		}

		.runtime-title {
			font-size: 13px;
			font-weight: 600;
			color: oklch(95% 0.01 58);
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.runtime-runtime {
			font-family: var(--font-mono);
			font-size: 10.5px;
			color: var(--orange);
			background: oklch(24% 0.06 44 / 0.6);
			border: 1px solid oklch(42% 0.14 44 / 0.4);
			padding: 2px 7px;
			border-radius: 100px;
		}

		.runtime-tasks {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 6px;
			margin-top: 4px;
		}

		@media (max-width: 520px) {
			.runtime-tasks {
				grid-template-columns: 1fr;
			}
		}

		.rt-chip {
			display: flex;
			align-items: center;
			gap: 6px;
			background: oklch(12% 0.014 48);
			border: 1px solid oklch(22% 0.016 48);
			border-radius: 6px;
			padding: 5px 8px;
			font-size: 11px;
			color: oklch(80% 0.01 58);
			font-family: var(--font-mono);
		}

		.rt-check {
			color: #10b981;
			font-weight: 700;
			font-size: 11px;
		}

		.rt-id {
			color: oklch(75% 0.1 58);
		}

		/* Step 3: Dual Output Branches */
		.pipe-branches-wrap {
			padding-left: 46px;
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.pipe-branch-label {
			font-size: 10.5px;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			font-weight: 600;
			color: oklch(50% 0.01 58);
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.pipe-branches {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
		}

		@media (max-width: 520px) {
			.pipe-branches {
				grid-template-columns: 1fr;
			}
			.pipe-branches-wrap {
				padding-left: 0;
			}
		}

		.pipe-branch-card {
			background: oklch(16% 0.014 48);
			border: 1px solid oklch(24% 0.016 48);
			border-radius: 10px;
			padding: 12px 14px;
			display: flex;
			flex-direction: column;
			gap: 6px;
			position: relative;
			overflow: hidden;
			transition:
				border-color 0.2s,
				transform 0.2s;
		}

		.pipe-branch-card:hover {
			border-color: oklch(34% 0.03 48);
			transform: translateY(-1px);
		}

		.branch-delivery {
			border-left: 3px solid var(--orange);
		}

		.branch-inbox {
			border-left: 3px solid #10b981;
		}

		.branch-top {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
		}

		.branch-icon {
			width: 24px;
			height: 24px;
			border-radius: 6px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 12px;
		}

		.branch-icon-send {
			background: oklch(24% 0.06 44 / 0.5);
			color: var(--orange);
		}

		.branch-icon-inbox {
			background: oklch(24% 0.06 150 / 0.5);
			color: #10b981;
		}

		.branch-status {
			font-size: 10px;
			font-family: var(--font-mono);
			font-weight: 600;
			color: var(--orange);
			background: oklch(20% 0.06 44 / 0.5);
			padding: 1px 6px;
			border-radius: 4px;
		}

		.branch-status-sync {
			color: #10b981;
			background: oklch(20% 0.06 150 / 0.5);
		}

		.branch-title {
			font-size: 12px;
			font-weight: 600;
			color: oklch(90% 0.01 58);
		}

		.branch-meta {
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-family: var(--font-mono);
			font-size: 10px;
			color: oklch(52% 0.01 58);
			margin-top: 2px;
		}

		.bm-time {
			color: oklch(65% 0.12 150);
		}

		/* Footer */
		.pipeline-footer {
			background: oklch(12% 0.014 48);
			border-top: 1px solid oklch(20% 0.014 48);
			padding: 10px 18px;
			display: flex;
			align-items: center;
			justify-content: space-around;
			font-family: var(--font-mono);
			font-size: 11px;
		}

		.p-metric {
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.pm-label {
			color: oklch(48% 0.01 58);
		}

		.pm-value {
			color: oklch(80% 0.01 58);
			font-weight: 600;
		}

		.p-metric-sep {
			width: 1px;
			height: 12px;
			background: oklch(22% 0.014 48);
		}

		.highlight-green {
			color: #10b981;
		}

		.highlight-orange {
			color: var(--orange);
		}

		/* ── API SECTION ──────────────────────────────────────────── */
		.api-section {
			background: var(--bg-alt);
			border-top: 1px solid var(--border);
			border-bottom: 1px solid var(--border);
		}

		.api-wrap {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: clamp(2rem, 5vw, 4rem);
			align-items: center;
		}

		@media (max-width: 720px) {
			.api-wrap {
				grid-template-columns: 1fr;
			}
		}

		.api-features {
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 16px;
			margin-top: 32px;
		}

		.api-features li {
			display: flex;
			gap: 12px;
			align-items: flex-start;
		}

		.api-features .check {
			color: var(--orange);
			font-weight: 700;
			font-size: 14px;
			flex-shrink: 0;
			margin-top: 3px;
		}

		.api-features li .line {
			font-size: 0.9rem;
			color: var(--text-muted);
			line-height: 1.6;
		}

		.api-features li strong {
			display: block;
			color: var(--text);
			font-weight: 500;
			font-size: 0.9375rem;
		}

		.code-window {
			background: var(--bg-dark);
			border-radius: var(--radius-lg);
			overflow: hidden;
			box-shadow:
				0 16px 48px oklch(0% 0 0 / 0.16),
				0 0 0 1px oklch(100% 0 0 / 0.05);
		}

		.code-window-bar {
			background: var(--bg-dark-2);
			padding: 10px 16px;
			display: flex;
			align-items: center;
			gap: 7px;
		}

		.terminal-title {
			margin-left: auto;
			font-size: 11px;
			color: oklch(42% 0.01 58);
			font-family: var(--font-mono);
		}

		.code-window-body {
			padding: 20px 22px 22px;
			font-family: var(--font-mono);
			font-size: 12.5px;
			line-height: 1.75;
		}

		.c-method {
			color: oklch(72% 0.14 230);
			font-weight: 600;
		}
		.c-path {
			color: oklch(78% 0.1 80);
		}
		.c-header {
			color: oklch(64% 0.01 58);
		}
		.c-key {
			color: oklch(72% 0.14 230);
		}
		.c-str {
			color: oklch(74% 0.12 85);
		}
		.c-punct {
			color: oklch(56% 0.01 58);
		}
		.c-cmt {
			color: oklch(44% 0.01 58);
			font-style: italic;
		}

		/* ── WHY SECTION ──────────────────────────────────────────── */
		.why-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 18px;
		}

		.why-card {
			background: var(--bg-card);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			padding: 26px 26px 22px;
			transition: border-color 0.15s;
		}

		.why-card:hover {
			border-color: var(--orange-mid);
		}

		.why-card .card-icon {
			font-size: 24px;
			line-height: 1;
			margin-bottom: 14px;
			display: block;
		}

		.why-card h3 {
			font-size: 0.975rem;
			font-weight: 600;
			margin-bottom: 8px;
			letter-spacing: -0.01em;
			line-height: 1.35;
		}

		.why-card p {
			font-size: 0.9rem;
			color: var(--text-muted);
			line-height: 1.65;
		}

		/* ── VS SECTION ───────────────────────────────────────────── */
		.vs-section {
			background: var(--bg-alt);
			border-top: 1px solid var(--border);
			border-bottom: 1px solid var(--border);
		}

		.vs-split {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px;
		}
		@media (max-width: 680px) {
			.vs-split {
				grid-template-columns: 1fr;
			}
		}

		.vs-card {
			border-radius: var(--radius-lg);
			overflow: hidden;
			border: 1px solid var(--border);
		}

		.vs-card-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 12px;
			padding: 20px 24px 18px;
			border-bottom: 1px solid var(--border);
		}
		.vs-card-cf .vs-card-header {
			background: oklch(95% 0.005 230);
			border-bottom-color: oklch(88% 0.01 230);
		}
		.vs-card-ef .vs-card-header {
			background: var(--orange-light);
			border-bottom-color: var(--orange-mid);
		}

		.vs-card-cf {
			background: var(--bg-card);
		}
		.vs-card-ef {
			background: oklch(99.5% 0.015 55);
		}

		.vs-header-top {
			display: flex;
