			.features-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		@media (max-width: 700px) {
			.features-grid {
				grid-template-columns: 1fr 1fr;
			}
		}
		@media (max-width: 480px) {
			.features-grid {
				grid-template-columns: 1fr;
			}
