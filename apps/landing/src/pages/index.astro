			padding: 2px 9px;
			margin-top: 12px;
		}

		/* ── LAYOUTS SHOWCASE ─────────────────────────────────────── */
		.layouts-section {
			background: var(--bg-alt);
			border-top: 1px solid var(--border);
			border-bottom: 1px solid var(--border);
		}

		.layouts-scroll {
