---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import { buttonVariants } from "@/components/ui/button";
import { site } from "@/lib/site";
import { faqJsonLd } from "@/lib/faq";
import type { FaqItem } from "@/components/islands/Faq";
import Section from "@/components/site/Section.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";
import CodeBlock from "@/components/site/CodeBlock.astro";
import PageHero from "@/components/sections/PageHero.astro";
import CtaBand from "@/components/sections/CtaBand.astro";
import Faq from "@/components/islands/Faq";
import TemplateGallery from "@/components/product/TemplateGallery";
import ShotCrop from "@/components/product/ShotCrop.astro";
import FeatureRow from "@/components/product/FeatureRow.astro";
import FeatureCard from "@/components/product/FeatureCard.astro";
import SyntaxExample from "@/components/product/SyntaxExample.astro";
import ThemeSwatches from "@/components/product/ThemeSwatches.astro";
import Callout from "@/components/product/Callout.astro";
import { categories, layouts, themeList } from "@/components/product/templates-data";
import { renderSample } from "@/components/product/render-sample";
import { breadcrumbJsonLd } from "@/components/product/jsonld";

const count = layouts.length;

const examples = [
	{
		title: "Variables",
		body: "Put a value in double braces. Pass the values in <code>variables</code> when you send. The same variables fill the subject line.",
		template: `<p>Hi {{name}},</p>\n<p>Order <strong>{{orderId}}</strong> is on its way.</p>`,
		data: { name: "Alex", orderId: "ORD-1042" },
	},
	{
		title: "Nested values",
		body: "Reach into objects with dots. <code>variables</code> can hold objects as well as strings and numbers.",
		template: `{{plan.name}} plan, renews {{plan.renewsOn}}`,
		data: { plan: { name: "Pro", renewsOn: "Dec 1" } },
	},
	{
		title: "Conditionals",
		body: "Show a block only when a value is set, with an optional <code>else</code>. <code>unless</code> does the reverse. Empty strings, empty lists, zero and false count as not set.",
		template: `{{#if trialDays}}\n  Your trial ends in {{trialDays}} days.\n{{else}}\n  Thanks for being a customer.\n{{/if}}`,
		data: { trialDays: 3 },
	},
	{
		title: "Missing values",
		body: "A variable you do not send renders as nothing. It never shows as <code>{{code}}</code> to your customer, but it can leave a gap, so check the output in the playground.",
		template: `Hi {{name}}, your code is {{code}}.`,
		data: { name: "Alex" },
	},
	{
		title: "Repeated rows",
		body: "Build lists in your own code and pass the finished markup. The template inserts it as written.",
		template: `<ul>{{items}}</ul>`,
		data: { items: "<li>Widget</li><li>Gadget</li>" },
	},
	{
		title: "Styling",
		body: "Use inline CSS, which is the most reliable across mail clients. Pass colours and fonts as variables to reuse one template across brands.",
		template: `<h1 style="color: {{brandColor}};\n           font-family: {{font}};">\n  Hello {{name}}\n</h1>`,
		data: { name: "Alex", brandColor: "#f97316", font: "Arial, sans-serif" },
	},
].map((e) => ({ ...e, output: renderSample(e.template, e.data) }));

const sendBySlug = `curl -X POST ${site.demoApi}/v1/send \\
  -H "Authorization: Bearer eflive_your_api_key" \\
  -H "Content-Type: application/json" \\
  -d '{
    "from": "hello@yourdomain.com",
    "to": "alex@example.com",
    "templateSlug": "welcome",
    "themeId": "ocean",
    "variables": {
      "name": "Alex",
      "appName": "Acme",
      "loginUrl": "https://app.acme.dev/login"
    }
  }'`;

const faq: FaqItem[] = [
	{
		q: "Can I edit a built-in layout?",
		a: "No. Built-in layouts are system templates, and the app does not let you edit or delete them. For a design of your own, create a custom template.",
	},
	{
		q: "Do themes apply to custom templates?",
		a: "No. <code>themeId</code> only changes built-in layouts. Style a custom template with inline CSS, or pass colours as variables.",
	},
	{
		q: "Are variables escaped?",
		a: "No. Values are inserted exactly as you send them. If a value comes from user input, escape it before you pass it in.",
	},
	{
		q: "Can I manage templates with an API key?",
		a: "An API key can send with any template through <code>/v1/send</code>. Creating and editing templates uses the dashboard, or the <code>/api/templates</code> endpoints with a signed-in session.",
	},
	{
		q: "Which Handlebars features work?",
		a: "Variables, nested paths, <code>if</code>, <code>else</code> and <code>unless</code>. Workers cannot compile templates, so EmailFlare runs its own small interpreter instead of the Handlebars library. Loops and <code>with</code> blocks are not dependable yet.",
	},
];
---

<Base
	title="Email template library and Handlebars guide"
	description={`${count} built-in transactional email layouts with five colour themes, plus custom templates written in Handlebars. Send any of them by slug from POST /v1/send.`}
	path="/templates"
	jsonLd={[faqJsonLd(faq), breadcrumbJsonLd("Templates", "/templates")]}
>
	<PageHero
		eyebrow="Templates"
		title="The mail every app sends, ready to go."
		description={`${count} built-in layouts for sign-in, security, billing and product notices, in five colour themes. Or write your own in Handlebars. Send either one by slug.`}
	>
		<a href="#library" class={buttonVariants({ size: "xl" })}>
			Browse the library
			<Icon name="lucide:arrow-down" />
		</a>
		<a href="/docs/send-an-email" class={buttonVariants({ size: "xl", variant: "outline" })}>
			Send with a template
		</a>
	</PageHero>

	<Section id="library">
		<SectionHeading
			eyebrow="Built-in layouts"
			title={`${count} layouts, rendered for real.`}
			description="Every thumbnail below is the HTML the Worker produces for that layout with sample values. Pick a theme, filter by category and open one to see its variables."
		/>
		<div class="mt-10">
			<TemplateGallery
				client:visible
				layouts={layouts}
				categories={[...categories]}
				themes={themeList}
				apiHost={site.demoApi}
			/>
		</div>
		<p class="text-muted-foreground mt-8 max-w-3xl text-sm leading-6">
			The built-in layouts share one structure, so they differ in the fields they show and the words around them,
			not in their design. They are read-only. If you want a specific look, write a custom template.
		</p>
	</Section>

	<Section id="kinds" tone="muted">
		<SectionHeading
			eyebrow="Two kinds"
			title="Built-in layouts and your own templates."
			description="You send both the same way. A slug in the request is all it takes."
		/>
		<div class="mt-12 grid gap-5 md:grid-cols-2">
			<FeatureCard
				icon="lucide:layout-template"
				title={`${count} built-in layouts`}
				body="Added to your database by a migration when you deploy, as system templates. Each one lists the variables it uses. Change the look with a theme, and send by slug, such as welcome or password-reset. They cannot be edited or deleted."
			/>
			<FeatureCard
				icon="lucide:code-xml"
				title="Custom templates"
				body="Write your own subject, HTML body and optional plain-text body. Choose a slug of lowercase letters, numbers and hyphens, and optionally scope the template to one domain. If the slug is taken, EmailFlare adds a short suffix and tells you the final one."
			/>
		</div>
	</Section>

	<Section id="syntax">
		<SectionHeading
			eyebrow="Handlebars guide"
			title="The syntax, with real output."
			description="Each result below was produced by the same renderer your Worker runs, when this page was built."
		/>
		<div class="divide-border mt-12 space-y-12 divide-y">
			{examples.map((e, i) => (
				<div class={i > 0 ? "pt-12" : ""}>
					<SyntaxExample
						title={e.title}
						body={e.body}
						template={e.template}
						data={e.data}
						output={e.output}
					/>
				</div>
			))}
		</div>
		<Callout title="What this is, and is not" icon="lucide:triangle-alert" class="mt-14">
			<p>
				Cloudflare Workers cannot compile templates at runtime, so EmailFlare uses a small Handlebars-compatible
				interpreter instead of the Handlebars library. It supports the pieces above, plus <code>unless</code>.
			</p>
			<p>
				Loops (<code>each</code>) and <code>with</code> blocks are not dependable yet, so build repeated markup
				in your code. Values are not HTML-escaped, so escape anything a user typed before you send it.
			</p>
		</Callout>
	</Section>

	<Section id="themes" tone="muted">
		<SectionHeading
			eyebrow="Themes"
			title="Five colour themes for the built-in layouts."
			description="Set themeId on the request. The theme changes the accent, background and text colours, and nothing else."
		/>
		<div class="mt-10">
			<ThemeSwatches themes={themeList} />
		</div>
	</Section>

	<Section id="use">
		<FeatureRow
			eyebrow="In your code"
			title="Send by slug. Pass the variables."
			description="No template engine in your app and no HTML in your repository. Change the email in the dashboard and the next send uses it."
			points={[
				"<code>subject</code> in the request overrides the template subject",
				"<code>variables</code> fill the subject and, for custom templates, the body",
				"A test key renders the template into the test mailbox without delivering it",
			]}
		>
			<a href="/email-api" class={buttonVariants({ size: "lg", variant: "outline" }) + " mt-8"}>
				See the full API
			</a>
			<div slot="media" class="min-w-0">
				<CodeBlock code={sendBySlug} lang="bash" title="POST /v1/send" />
			</div>
		</FeatureRow>
	</Section>

	<Section id="editor" tone="muted">
		<FeatureRow
			reverse
			eyebrow="In the dashboard"
			title="Search, preview and write templates."
			description="The Templates page lists every layout and custom template. Open one to preview it with sample variables and a theme, or create a new template."
			points={[
				"Search by name, slug or subject",
				"Preview built-in layouts in any theme",
				"Create custom templates with a subject, HTML and plain-text body",
				"Test a send from the playground before you ship",
			]}
		>
			<ShotCrop
				slot="media"
				file="templates"
				alt="The Templates page listing built-in layouts with a search box and category filters"
				x={320}
				y={60}
				w={700}
				h={480}
			/>
		</FeatureRow>
	</Section>

	<Section id="faq" size="narrow">
		<SectionHeading align="center" eyebrow="FAQ" title="Template questions." />
		<div class="mt-10">
			<Faq client:visible items={faq} />
		</div>
	</Section>

	<CtaBand
		title="Stop hard-coding email in your app."
		description="Deploy EmailFlare, pick a layout and send it by slug. Your templates and your mail stay in your own account."
	/>
</Base>
