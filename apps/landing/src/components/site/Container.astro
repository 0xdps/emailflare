---
import { cn } from "@/lib/utils";

interface Props {
	as?: string;
	size?: "default" | "narrow" | "wide";
	class?: string;
}
const { as: Tag = "div", size = "default", class: className } = Astro.props;
const widths = { default: "max-w-6xl", narrow: "max-w-3xl", wide: "max-w-7xl" };
---

<Tag class={cn("mx-auto w-full px-5 md:px-8", widths[size], className)}>
	<slot />
</Tag>
