---
interface Theme {
	id: string;
	label: string;
	primary: string;
	background: string;
	heading: string;
}
interface Props {
	themes: Theme[];
}
const { themes } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
	{themes.map((t) => (
		<li class="border-border bg-card overflow-hidden rounded-xl border">
			<div class="flex h-20 items-end gap-2 border-b p-3" style={`background:${t.background}`}>
				<span class="size-6 rounded-md border" style={`background:${t.primary}`} aria-hidden="true" />
				<span class="size-6 rounded-md border" style={`background:${t.heading}`} aria-hidden="true" />
			</div>
			<div class="p-3">
				<p class="font-medium">{t.label}</p>
				<p class="text-muted-foreground font-mono text-xs">themeId: "{t.id}"</p>
			</div>
		</li>
	))}
</ul>
