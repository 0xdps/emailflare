---
import CodeBlock from "@/components/site/CodeBlock.astro";

interface Props {
	title: string;
	body: string;
	template: string;
	/** Variables passed to the template, shown as JSON */
	data: Record<string, unknown>;
	/** Real output of the dashboard's renderer for this template and data */
	output: string;
}
const { title, body, template, data, output } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.5fr)] lg:gap-10">
	<div>
		<h3 class="text-xl font-semibold">{title}</h3>
		<p class="text-muted-foreground mt-2 text-[0.9375rem] leading-7" set:html={body} />
	</div>
	<div class="min-w-0 space-y-3">
		<div class="grid gap-3 md:grid-cols-2">
			<CodeBlock code={template} lang="handlebars" title="template" />
			<CodeBlock code={JSON.stringify(data, null, 2)} lang="json" title="variables" />
		</div>
		<div class="border-border bg-card rounded-xl border px-4 py-3">
			<p class="text-muted-foreground mb-1 font-mono text-2xs tracking-wide uppercase">Result</p>
			<pre class="font-mono text-[0.8125rem] leading-6 whitespace-pre-wrap">{output.trim()}</pre>
		</div>
	</div>
</div>
