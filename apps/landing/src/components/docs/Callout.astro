---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/utils";

interface Props {
	tone?: "note" | "warning";
	title?: string;
	class?: string;
}
const { tone = "note", title, class: className } = Astro.props;
const tones = {
	note: {
		box: "bg-primary-muted border-primary/30 text-primary-muted-foreground",
		icon: "lucide:info",
		iconClass: "text-primary",
	},
	warning: {
		box: "bg-destructive/10 border-destructive/30 text-foreground",
		icon: "lucide:triangle-alert",
		iconClass: "text-destructive",
	},
};
const t = tones[tone];
---

<aside
	class={cn(
		"flex gap-3 rounded-xl border p-4 text-sm leading-6",
		"[&_code]:bg-card [&_code]:text-foreground [&_code]:rounded-md [&_code]:border [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.8125rem] [&_code]:break-words",
		"[&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4 [&_strong]:font-semibold",
		t.box,
		className,
	)}
>
	<Icon name={t.icon} class={cn("mt-0.5 size-4.5 shrink-0", t.iconClass)} />
	<div class="min-w-0 space-y-1.5">
		{title && <p class="text-foreground font-semibold">{title}</p>}
		<slot />
	</div>
</aside>
