---
import { Icon } from "astro-icon/components";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { site } from "@/lib/site";
import Section from "@/components/site/Section.astro";

interface Props {
	title?: string;
	description?: string;
	class?: string;
}
const {
	title = "Own your email. Deploy it in minutes.",
	description = "Click once, finish a short setup wizard, and send your first message from your own domain. No servers to patch, no per-email pricing, no vendor holding your mail.",
	class: className,
} = Astro.props;
---

<Section class={cn("pb-24", className)}>
	<div class="bg-ink text-ink-foreground relative overflow-hidden rounded-3xl px-6 py-14 text-center md:px-16 md:py-20 dark:border">
		<div
			class="from-primary/25 pointer-events-none absolute inset-x-0 -top-24 mx-auto h-64 max-w-xl rounded-full bg-gradient-to-b to-transparent blur-3xl"
			aria-hidden="true"
		></div>
		<h2 class="relative mx-auto max-w-2xl text-3xl leading-[1.1] font-semibold md:text-5xl">{title}</h2>
		<p class="text-ink-muted relative mx-auto mt-5 max-w-xl text-lg leading-8">{description}</p>
		<div class="relative mt-9 flex flex-wrap justify-center gap-3">
			<a href={site.deploy} class={buttonVariants({ size: "xl" })}>
				<Icon name="lucide:cloud-upload" />
				Deploy to Cloudflare
			</a>
			<a
				href="/docs"
				class={cn(
					buttonVariants({ size: "xl", variant: "outline" }),
					"!bg-transparent text-ink-foreground border-ink-border hover:!bg-ink-border hover:!text-ink-foreground",
				)}
			>
				Read the docs
			</a>
		</div>
	</div>
</Section>
