                  <span><span class="cb-url">http://localhost:8090</span><span class="cb-cmt">&nbsp;&nbsp;# admin UI</span></span>
                </div>
              </div>
            </div>
          </div>
          <div class="do-footer do-footer-docker">
            <span class="do-footer-note">Image: <code style="font-size:11px;">ghcr.io/0xdps/emailflare:latest</code></span>
            <a href="/docs">Full Docker guide →</a>
