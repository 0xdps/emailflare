                <path d="M70.9 45.4c-.3 0-.7 0-1 .1-.2 0-.4.2-.5.4l-1.4 4.8c-.4 1.4-.2 2.7.5 3.7.7.9 1.8 1.4 3.1 1.5l5.4.3c.2 0 .4.1.5.2.1.2.1.4 0 .6-.2.4-.7.7-1.2.7l-5.6.3c-3 .1-6.2 2.6-7.4 5.5l-.4 1c-.1.2 0 .4.2.4h18.7c.3 0 .5-.2.6-.5.3-1 .5-2 .5-3.1-.1-8.3-6.7-15-15-15" fill="#FAAE40"/>
