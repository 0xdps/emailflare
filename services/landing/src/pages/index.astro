---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "EmailFlare",
  "url": "https://emailflare.dev",
  "description": "EmailFlare ships two open-source products: a REST email sending API on Cloudflare Email Sending (Docker or Workers), and a hosted team inbox built on Cloudflare Email Routing with D1, R2, and Durable Objects.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Cloudflare Workers, Docker",
  "license": "https://github.com/0xdps/emailflare/blob/trunk/LICENSE",
  "codeRepository": "https://github.com/0xdps/emailflare",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<Base
  title="EmailFlare — Email API and Inbox for Cloudflare"
  description="EmailFlare ships two open-source products: a REST email sending API on Cloudflare Email Sending (Docker or Workers), and a hosted team inbox built on Cloudflare Email Routing with D1, R2, and Durable Objects."
  keywords="emailflare, self-hosted email, cloudflare email sending, transactional email, open source email api, cloudflare inbox, team inbox cloudflare, email routing inbox, react email templates"
  canonical="https://emailflare.dev/"
  ogUrl="https://emailflare.dev/"
  ogType="website"
  navType="home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

<style is:global>
  /* ── HERO ─────────────────────────────────────────────────── */
  .hero {
    padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6.5rem);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 70% at 72% 40%, oklch(93% 0.06 58 / 0.5) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-top-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--orange-light);
    color: var(--orange-hover);
    font-size: 12.5px;
    font-weight: 500;
    padding: 4px 13px;
    border-radius: 100px;
    border: 1px solid var(--orange-mid);
  }

  .hero-sponsor {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: oklch(97% 0.02 10);
    color: oklch(48% 0.2 10);
    font-size: 12.5px;
    font-weight: 500;
    padding: 4px 13px;
    border-radius: 100px;
    border: 1px solid oklch(88% 0.06 10);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .hero-sponsor:hover { background: oklch(93% 0.04 10); border-color: oklch(80% 0.1 10); }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.6rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.028em;
    margin: 0 0 22px;
    color: var(--text);
  }

  .hero h1 em { font-style: italic; color: var(--orange); }

  .hero-sub {
    font-size: clamp(0.93rem, 1.7vw, 1.04rem);
    color: var(--text-muted);
    max-width: 460px;
    margin: 0 0 34px;
    line-height: 1.72;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-visual { position: relative; }

  @media (max-width: 860px) {
    .hero-split { grid-template-columns: 1fr; }
    .hero h1 { font-size: clamp(2.3rem, 7vw, 3.1rem); }
    .hero-sub { max-width: 520px; }
  }

  /* ── EMAIL FLOW DIAGRAM ────────────────────────────────────── */
  .email-flow-wrap {
    background: var(--bg-dark);
    border-radius: var(--radius-lg);
    box-shadow:
      0 32px 72px oklch(0% 0 0 / 0.22),
      0 0 0 1px oklch(100% 0 0 / 0.06),
      inset 0 1px 0 oklch(100% 0 0 / 0.04);
    overflow: hidden;
    padding: 28px 22px 24px;
  }

  .email-flow-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes ef-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.22; }
  }

  /* ── API SECTION ──────────────────────────────────────────── */
  .api-section {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .api-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 720px) {
    .api-wrap { grid-template-columns: 1fr; }
  }

  .api-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .api-features li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .api-features .check {
    color: var(--orange);
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .api-features li .line {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .api-features li strong {
    display: block;
    color: var(--text);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .code-window {
    background: var(--bg-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 16px 48px oklch(0% 0 0 / 0.16),
      0 0 0 1px oklch(100% 0 0 / 0.05);
  }

  .code-window-bar {
    background: var(--bg-dark-2);
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .terminal-title {
    margin-left: auto;
    font-size: 11px;
    color: oklch(42% 0.01 58);
    font-family: var(--font-mono);
  }

  .code-window-body {
    padding: 20px 22px 22px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
  }

  .c-method  { color: oklch(72% 0.14 230); font-weight: 600; }
  .c-path    { color: oklch(78% 0.10 80); }
  .c-header  { color: oklch(64% 0.01 58); }
  .c-key     { color: oklch(72% 0.14 230); }
  .c-str     { color: oklch(74% 0.12 85); }
  .c-punct   { color: oklch(56% 0.01 58); }
  .c-cmt     { color: oklch(44% 0.01 58); font-style: italic; }

  /* ── WHY SECTION ──────────────────────────────────────────── */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }

  .why-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 26px 26px 22px;
    transition: border-color 0.15s;
  }

  .why-card:hover { border-color: var(--orange-mid); }

  .why-card .card-icon {
    font-size: 24px;
    line-height: 1;
    margin-bottom: 14px;
    display: block;
  }

  .why-card h3 {
    font-size: 0.975rem;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .why-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* ── VS SECTION ───────────────────────────────────────────── */
  .vs-section { background: var(--bg-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .vs-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 680px) { .vs-split { grid-template-columns: 1fr; } }

  .vs-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .vs-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 24px 18px;
    border-bottom: 1px solid var(--border);
  }
  .vs-card-cf .vs-card-header { background: oklch(95% 0.005 230); border-bottom-color: oklch(88% 0.01 230); }
  .vs-card-ef .vs-card-header { background: var(--orange-light); border-bottom-color: var(--orange-mid); }

  .vs-card-cf { background: var(--bg-card); }
  .vs-card-ef { background: oklch(99.5% 0.015 55); }

  .vs-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .vs-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .vs-card-cf .vs-title { color: oklch(35% 0.02 230); }
  .vs-card-ef .vs-title { color: var(--orange-hover); }

  .vs-subtitle { font-size: 12.5px; color: var(--text-faint); }

  .vs-badge {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 99px;
    flex-shrink: 0;
  }
  .vs-badge-cf { background: oklch(89% 0.01 230); color: oklch(40% 0.02 230); border: 1px solid oklch(82% 0.015 230); }
  .vs-badge-ef { background: var(--orange); color: #fff; }

  .vs-rows { padding: 6px 0; }

  .vs-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.45;
  }
  .vs-row:last-child { border-bottom: none; }
  .vs-card-cf .vs-row:hover { background: oklch(97.5% 0.005 230); }
  .vs-card-ef .vs-row:hover { background: oklch(98.5% 0.018 55); }

  .vs-header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vs-icon { flex-shrink: 0; width: 18px; text-align: center; font-size: 13px; font-weight: 700; }
  .vs-card-cf .vs-icon { color: oklch(54% 0.16 24); }
  .vs-card-ef .vs-icon { color: oklch(50% 0.18 150); }

  .do-badge svg { width: 13px; height: 13px; display: inline-block; vertical-align: -2px; margin-right: 2px; }

  .vs-row-label { color: var(--text); }
  .vs-row code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: oklch(93% 0.01 55);
    padding: 1px 5px;
    border-radius: 4px;
    color: var(--text);
  }

  /* ── FEATURES GRID ────────────────────────────────────────── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }

  @media (max-width: 1100px) {
    .features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .features-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .features-grid { grid-template-columns: 1fr; }
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 18px 16px;
    transition: border-color 0.15s;
  }

  .feature-card:hover { border-color: var(--border-strong); }

  .feature-card .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--orange-light);
    margin-bottom: 12px;
  }
  .feature-card .card-icon svg { width: 18px; height: 18px; color: var(--orange-hover); }

  .feature-card h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 7px;
    letter-spacing: -0.01em;
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .feature-card p code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: oklch(93% 0.006 60);
    padding: 1px 5px;
    border-radius: 4px;
    color: var(--text);
  }

  .feature-tag {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 500;
    color: var(--orange-hover);
    background: var(--orange-light);
    border: 1px solid var(--orange-mid);
    border-radius: 100px;
    padding: 2px 9px;
    margin-top: 12px;
  }

  /* ── LAYOUTS SHOWCASE ─────────────────────────────────────── */
  .layouts-section { background: var(--bg-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .layouts-scroll {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .layout-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 450;
    transition: border-color 0.15s, color 0.15s;
  }

  .layout-chip::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--orange-mid);
    flex-shrink: 0;
  }

  .layout-chip:hover { border-color: var(--orange-mid); color: var(--orange-hover); }

  /* ── DEPLOY SECTION ───────────────────────────────────────── */
  .deploy-section {
    background: var(--bg-dark);
    color: oklch(88% 0.01 58);
  }

  .deploy-section .section-eyebrow { color: var(--orange); }
  .deploy-section .section-title { color: oklch(95% 0.008 58); }
  .deploy-section .section-sub { color: oklch(60% 0.01 58); }

  /* two-column option cards */
  .deploy-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 48px;
  }

  @media (max-width: 780px) {
    .deploy-options { grid-template-columns: 1fr; }
  }

  .deploy-option {
    background: var(--bg-dark-2);
    border: 1px solid oklch(26% 0.012 48);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .do-header {
    padding: 24px 28px 20px;
    border-bottom: 1px solid oklch(20% 0.012 48);
  }

  .do-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 99px;
    margin-bottom: 14px;
  }

  .do-badge-docker {
    background: oklch(22% 0.04 230 / 0.5);
    color: oklch(68% 0.12 230);
    border: 1px solid oklch(34% 0.08 230 / 0.5);
  }

  .do-badge-worker {
    background: oklch(22% 0.06 48 / 0.5);
    color: var(--orange);
    border: 1px solid oklch(34% 0.10 48 / 0.5);
  }

  .do-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: oklch(93% 0.01 58);
    margin-bottom: 8px;
  }

  .do-sub {
    font-size: 0.875rem;
    color: oklch(56% 0.01 58);
    line-height: 1.6;
  }

  .do-steps {
    padding: 20px 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .do-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .do-step-num {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid oklch(30% 0.012 48);
    font-size: 11px;
    font-weight: 700;
    color: oklch(44% 0.01 58);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .do-step-label {
    font-size: 13px;
    font-weight: 600;
    color: oklch(84% 0.01 58);
    margin-bottom: 6px;
  }

  .do-step-desc {
    font-size: 12.5px;
    color: oklch(52% 0.01 58);
    line-height: 1.55;
    margin-bottom: 8px;
  }

  .do-footer {
    padding: 16px 28px;
    border-top: 1px solid oklch(20% 0.012 48);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .do-footer-note {
    font-size: 12px;
    color: oklch(44% 0.01 58);
  }

  .do-footer a {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .do-footer-docker a { color: oklch(62% 0.12 230); }
  .do-footer-worker a { color: var(--orange); }

  .code-block {
    background: oklch(10% 0.012 48);
    border: 1px solid oklch(22% 0.012 48);
    border-radius: 8px;
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.75;
    overflow-x: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cb-kw  { color: oklch(72% 0.14 165); }
  .cb-val { color: oklch(74% 0.12 82); }
  .cb-cmt { color: oklch(42% 0.01 58); font-style: italic; }
  .cb-cmd { color: oklch(80% 0.12 48); }
  .cb-url { color: var(--orange); }

  /* extra links below cards */
  .deploy-extras {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .deploy-extra {
    display: flex;
    align-items: center;
    gap: 12px;
    background: oklch(16% 0.012 48);
    border: 1px solid oklch(24% 0.012 48);
    border-radius: 10px;
    padding: 14px 18px;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .deploy-extra:hover { border-color: oklch(38% 0.02 48); }
  .de-icon { font-size: 20px; flex-shrink: 0; }
  .de-title { font-size: 13px; font-weight: 600; color: oklch(84% 0.01 58); margin-bottom: 2px; }
  .de-sub   { font-size: 12px; color: oklch(48% 0.01 58); }
  .de-arrow { margin-left: auto; color: oklch(40% 0.01 58); font-size: 13px; }

  /* ── ARCHITECTURE ─────────────────────────────────────────── */
  .arch-wrap {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (max-width: 720px) {
    .arch-wrap { grid-template-columns: 1fr; }
  }

  .arch-diagram {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .arch-box {
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    padding: 10px 14px;
    margin-bottom: 10px;
    background: var(--bg-alt);
    text-align: center;
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .arch-box.hi {
    border-color: var(--orange-mid);
    background: var(--orange-light);
    color: var(--orange-hover);
    font-weight: 600;
  }

  .arch-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 10px;
  }

  .arch-arrow { text-align: center; color: var(--text-faint); margin: -2px 0 2px; font-size: 12px; }

  .arch-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .arch-bullets li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .ab-check {
    color: var(--orange);
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .arch-bullets li .ab-text strong {
    display: block;
    color: var(--text);
    font-weight: 500;
    font-size: 0.9375rem;
    margin-bottom: 3px;
  }

  .arch-bullets li .ab-text span {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── OSS SECTION ──────────────────────────────────────────── */
  .oss-section {
    text-align: center;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
  }

  .oss-section .section-eyebrow { display: block; }
  .oss-section .section-title { margin: 0 auto 14px; }
  .oss-section .section-sub { margin: 0 auto 36px; }

  .oss-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .built-on {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-faint);
    flex-wrap: wrap;
  }

  .built-on a { color: var(--text-muted); text-decoration: none; }
  .built-on a:hover { color: var(--text); }
  .built-sep { color: var(--border-strong); }

  @media (max-width: 640px) {
    .why-grid { grid-template-columns: 1fr; }
  }

  /* ── PRODUCTS SPLIT ──────────────────────────────────────── */
  .products-section {
    background: var(--bg-alt);
