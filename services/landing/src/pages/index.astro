  <script slot="scripts" is:inline>
    function runStarCount() {
      function animateStars(target) {
        var start = 125;
        var duration = 1000;
        var startTime = null;
        var els = [
          document.getElementById('gh-stars-hero'),
          document.getElementById('gh-stars-oss')
        ];
        function easeOut(t) { return 1 - Math.pow(1 - t, 3); }
        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / duration, 1);
          var current = Math.round(start + (target - start) * easeOut(progress));
          var label = '\u2605 ' + current;
          els.forEach(function(el) { if (el) el.textContent = label; });
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      fetch('https://api.github.com/repos/0xdps/emailflare')
        .then(function(r) { return r.json(); })
        .then(function(d) { if (d.stargazers_count) animateStars(d.stargazers_count); })
        .catch(function() {});
    }
    document.addEventListener('astro:page-load', runStarCount);
    document.addEventListener('DOMContentLoaded', runStarCount);
  </script>
