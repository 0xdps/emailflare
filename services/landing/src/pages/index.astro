  }
  .pf-check { font-weight: 700; font-size: 12px; flex-shrink: 0; }
  .pf-check-email { color: var(--orange); }
  .pf-check-inbox { color: var(--green); }

  .product-card-foot {
    padding: 18px 26px;
    border-top: 1px solid var(--border);
    display: flex; align-items: center;
    justify-content: space-between;
    gap: 14px; flex-wrap: wrap;
  }
