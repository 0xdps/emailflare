  .product-badge-node { background: oklch(94% 0.03 80); color: oklch(38% 0.12 80); border: 1px solid oklch(80% 0.1 80 / 0.4); }
  .product-sep { font-size: 11px; color: var(--text-faint); }

  .btn-orange-sm {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--orange); color: #fff;
    border: 1.5px solid var(--orange);
    border-radius: 7px; padding: 7px 16px;
    font-size: 13px; font-weight: 500;
    text-decoration: none; white-space: nowrap;
    transition: background 0.15s;
  }
  .btn-orange-sm:hover { background: var(--orange-hover); border-color: var(--orange-hover); }

  .btn-green-sm {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--green); color: oklch(12% 0.02 150);
    border: 1.5px solid var(--green);
    border-radius: 7px; padding: 7px 16px;
    font-size: 13px; font-weight: 500;
    text-decoration: none; white-space: nowrap;
