{
  // ── Cloudflare Workers config for emailflare-inbox ────────────────────────
  //
  // ★ FIRST-TIME SETUP:
  //   1. Create D1:   wrangler d1 create emailflare-inbox   → fill in database_id
  //   2. Create KV:   wrangler kv namespace create emailflare-inbox-rate-limit   → fill in id
  //   3. Create R2:   wrangler r2 bucket create emailflare-inbox-attachments
  //   4. Apply migrations:  pnpm migrations:apply:local
  //   5. Set secrets:
  //        wrangler secret put SESSION_SECRET     (min 32 chars, random)
  //        wrangler secret put CF_API_TOKEN       (CF token: Email Send + Zone + DNS)
  //        wrangler secret put CF_ACCOUNT_ID      (your CF account ID)
  //        wrangler secret put VAPID_PRIVATE_KEY  (VAPID private key for web push)
  //   6. Build dashboard: pnpm build:dashboard
  //   7. Deploy: wrangler deploy

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emailflare-inbox-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "upload_source_maps": true,

  // Inbox UI SPA — build with: cd services/inbox-ui && pnpm build
  "assets": {
    "directory": "../inbox-ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // D1 SQLite database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emailflare",
      "database_id": "569d845e-5691-4f71-84f6-e31a878e4bd6",
      "migrations_dir": "migrations"
    }
  ],

  // KV for login rate limiting
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "3b52ae5fc6b445bbb72526b8d2f8ca76"
    }
  ],

  // R2 for email attachments
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "emailflare-inbox-attachments"
    }
  ],

  // Durable Object for real-time push notifications
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATIONS",
        "class_name": "NotificationsHub"
      }
    ]
  },

  // DO class migrations — required so Cloudflare tracks the class on first deploy
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["NotificationsHub"]
    }
  ],

  // Queue for sequence email delivery
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "emailflare-inbox-sequences"
      }
    ],
    "consumers": [
      {
        "queue": "emailflare-inbox-sequences",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  },

  // Runtime env vars — set production values via `wrangler secret put`.
  // A Worker cannot declare a `var` and a `secret` with the same name, so
  // these are intentionally omitted here (see scripts/deploy-inbox.mjs).

  // Workers Rate Limiting for API key calls (100 req / 60s per key)
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 100,
          "period": 60
        }
      }
    ]
  },

  // Cron trigger for sequence processing (every 5 minutes)
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
