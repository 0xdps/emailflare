# ── Stage: build-core ─────────────────────────────────────────────────────────
# Builds the mesahub-server Go binary from source (same as root Dockerfile).
FROM golang:1.24-alpine AS build-core
RUN apk add --no-cache gcc musl-dev sqlite-dev git
ARG MESAHUB_CORE_VERSION=trunk
RUN --mount=type=secret,id=gh_token \
    git config --global url."https://$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/" && \
    git clone --depth 1 --branch ${MESAHUB_CORE_VERSION} \
    https://github.com/mesahub-db/mesahub-core.git /mesahub-core
WORKDIR /mesahub-core/server
RUN CGO_ENABLED=1 GOOS=linux go build -o /go/bin/mesahub-server ./cmd/server

# ── Stage: build-emails ────────────────────────────────────────────────────────
FROM node:22-alpine AS build-emails
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

# Copy workspace root config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy all workspace package.json files needed
COPY packages/email-core/package.json packages/email-core/tsconfig.json ./packages/email-core/
COPY packages/inbox-core/package.json packages/inbox-core/tsconfig.json ./packages/inbox-core/
COPY services/emails/package.json ./services/emails/
COPY services/inbox-server/package.json ./services/inbox-server/
COPY services/inbox-ui/package.json ./services/inbox-ui/

# Install all workspace deps at once
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source and build shared packages
COPY packages/email-core/src/ ./packages/email-core/src/
RUN pnpm --filter @emailflare/email-core build

COPY packages/inbox-core/src/ ./packages/inbox-core/src/
RUN pnpm --filter @emailflare/inbox-core build

COPY services/emails/ ./services/emails/
RUN pnpm --filter @emailflare/emails build

# Copy source and build inbox-server (run tsc directly to skip prebuild hook)
COPY services/inbox-server/ ./services/inbox-server/
RUN pnpm --filter @emailflare/inbox-server exec tsc

# ── Stage: build-inbox-ui ──────────────────────────────────────────────────────
FROM node:22-alpine AS build-inbox-ui
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

# Copy workspace root config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy inbox-ui package.json
COPY services/inbox-ui/package.json ./services/inbox-ui/

# Install workspace deps
RUN --mount=type=cache,id=pnpm-store-inbox,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source and build
COPY services/inbox-ui/ ./services/inbox-ui/
RUN pnpm --filter @emailflare/inbox-ui build

# ── Stage: caddy-bin ──────────────────────────────────────────────────────────
FROM caddy:2-alpine AS caddy-bin

# ── Stage: prod ───────────────────────────────────────────────────────────────
FROM node:22-alpine AS prod
COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
RUN apk add --no-cache curl openssl
WORKDIR /app

# mesahub-server binary (embedded mode)
COPY --from=build-core /go/bin/mesahub-server /usr/local/bin/mesahub-server
RUN mkdir -p /data
VOLUME ["/data"]

# inbox-server runtime (workspace layout mirrors repo)
COPY --from=build-emails   /app/services/emails/dist           ./services/emails/dist
COPY --from=build-emails   /app/services/emails/package.json   ./services/emails/package.json
COPY --from=build-emails   /app/packages/email-core/dist       ./packages/email-core/dist
COPY --from=build-emails   /app/packages/email-core/package.json ./packages/email-core/package.json
COPY --from=build-emails   /app/packages/inbox-core/dist       ./packages/inbox-core/dist
COPY --from=build-emails   /app/packages/inbox-core/package.json ./packages/inbox-core/package.json
COPY --from=build-emails   /app/node_modules/.pnpm             ./node_modules/.pnpm
COPY --from=build-emails   /app/services/inbox-server/dist     ./services/inbox-server/dist
COPY services/inbox-server/package.json                         ./services/inbox-server/

# Migration SQL files (needed at runtime for DB init)
COPY migrations/ ./migrations/

# Inbox UI static files
COPY --from=build-inbox-ui /app/services/inbox-ui/dist ./inbox-ui/dist

# Caddy config
COPY infra/Caddyfile.email-inbox /etc/caddy/Caddyfile
RUN caddy fmt --overwrite /etc/caddy/Caddyfile

# Startup script
COPY infra/start-email-inbox.sh /start-email-inbox.sh
RUN chmod +x /start-email-inbox.sh

EXPOSE 80
CMD ["/start-email-inbox.sh"]
