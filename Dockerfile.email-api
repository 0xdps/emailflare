# ── Stage: build-core ────────────────────────────────────────────────────────
# Clones mesahub-core and builds the Go binary from source.
# The Go module lives in server/ subdirectory — go install doesn't work.
# Override MESAHUB_CORE_VERSION at build time to pin a specific commit/tag:
#   docker build --build-arg MESAHUB_CORE_VERSION=main .
FROM golang:1.24-alpine AS build-core
RUN apk add --no-cache gcc musl-dev sqlite-dev git
ARG MESAHUB_CORE_VERSION=trunk
RUN --mount=type=secret,id=gh_token \
    git config --global url."https://$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/" && \
    git clone --depth 1 --branch ${MESAHUB_CORE_VERSION} \
    https://github.com/mesahub-db/mesahub-core.git /mesahub-core
WORKDIR /mesahub-core/server
RUN CGO_ENABLED=1 GOOS=linux go build -o /go/bin/mesahub-server ./cmd/server

# ── Stage: build-backend ──────────────────────────────────────────────────────
FROM node:22-alpine AS build-backend
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Build the shared email-core package first
COPY packages/email-core/package.json ./packages/email-core/package.json
COPY packages/email-core/tsconfig.json ./packages/email-core/tsconfig.json
RUN --mount=type=cache,id=pnpm-store-backend,target=/root/.local/share/pnpm/store \
    cd packages/email-core && pnpm install

COPY packages/email-core/src/ ./packages/email-core/src/
RUN cd packages/email-core && pnpm run build

# Build the shared emails package next (email-server depends on it via file:../emails)
COPY services/emails/package.json ./services/emails/package.json
RUN --mount=type=cache,id=pnpm-store-backend,target=/root/.local/share/pnpm/store \
    cd services/emails && pnpm install

COPY services/emails/ ./services/emails/
RUN cd services/emails && pnpm run build

# Now install and build the email-server (path mirrors repo layout for file: dep resolution)
COPY services/email-server/package.json services/email-server/pnpm-lock.yaml services/email-server/pnpm-workspace.yaml ./services/email-server/
RUN --mount=type=cache,id=pnpm-store-backend,target=/root/.local/share/pnpm/store \
    cd services/email-server && pnpm install --frozen-lockfile

COPY services/email-server/ ./services/email-server/
RUN cd services/email-server && pnpm run build

# ── Stage: build-email-ui ────────────────────────────────────────────────────
FROM node:22-alpine AS build-email-ui
WORKDIR /app/email-ui

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY services/email-ui/package.json services/email-ui/pnpm-lock.yaml services/email-ui/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store-admin,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY services/email-ui/ ./
RUN pnpm exec vite build

# ── Stage: prod (Caddy + Node) ──────────────────────────────────────────────
FROM caddy:2-alpine AS caddy-bin

FROM node:22-alpine AS prod
COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
RUN apk add --no-cache curl openssl
WORKDIR /app

# mesahub-server (for embedded mode — skipped if MESAHUB_URL points to external)
COPY --from=build-core /go/bin/mesahub-server /usr/local/bin/mesahub-server
RUN mkdir -p /data
VOLUME ["/data"]

RUN mkdir -p /usr/share/caddy

# Backend runtime (file: deps are resolved relative to services/email-server/, mirroring repo layout)
COPY --from=build-backend /app/services/emails/dist           ./services/emails/dist
COPY --from=build-backend /app/services/emails/package.json   ./services/emails/package.json
COPY --from=build-backend /app/packages/email-core/dist       ./packages/email-core/dist
COPY --from=build-backend /app/packages/email-core/package.json ./packages/email-core/package.json
COPY --from=build-backend /app/services/email-server/node_modules ./services/email-server/node_modules
COPY --from=build-backend /app/services/email-server/dist     ./services/email-server/dist
COPY services/email-server/package.json                       ./services/email-server/

# Email UI static files
COPY --from=build-email-ui /app/email-ui/dist /usr/share/caddy

COPY start-email-api.sh /app/start-email-api.sh
RUN chmod +x /app/start-email-api.sh

EXPOSE 80
CMD ["/app/start-email-api.sh"]
