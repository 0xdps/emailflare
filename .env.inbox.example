# EmailFlare · Inbox
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.inbox.local and fill in your values:
#   cp env-inbox.example .env.inbox.local
# Then start the inbox server dev stack:
#   just inbox-server-dev
#
# For the Cloudflare Worker variant (just inbox-dev) use scripts/config.toml
# instead — copy scripts/config.example.toml → scripts/config.toml.
#
# .env.inbox.local is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
INBOX_SERVER_PORT=3002

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Both must be 32+ characters. Generate each with:
#   openssl rand -hex 32
SESSION_SECRET=
# Shared HMAC secret between the inbox-bridge CF Worker and inbox-server.
# Used to authenticate inbound email webhook calls.
WEBHOOK_SECRET=

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Required for sending email replies via the CF Email Sending API.
# Token scopes: Zone.Email Routing (Edit) + Account.Email Sending (Edit)
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── Public URL ────────────────────────────────────────────────────────────────
# Public base URL of this inbox deployment, used to build one-click unsubscribe
# links (List-Unsubscribe headers) in sequence sends.
# e.g. https://inbox.example.com
PUBLIC_URL=

# ── Database (MesaHub / SQLite) ───────────────────────────────────────────────
# Local dev: mesahub-inbox container started by `just inbox-server-deps`.
# Token must match MESAHUB_ADMIN_TOKEN in compose.inbox.dev.yaml.
MESAHUB_URL=mh://inbox-dev-token@localhost:3003/inbox-db
# External MesaHub instance:
# MESAHUB_URL=mh://your_api_key@your-host:port/inbox-db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: redis-inbox container started by `just inbox-server-deps`.
REDIS_URL=redis://localhost:6379

# ── R2 (attachment storage) ───────────────────────────────────────────────────
# Optional for local dev — attachments won't be stored but the server starts fine.
# Get tokens: Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=emailflare-inbox-attachments

# ── Migrations ────────────────────────────────────────────────────────────────
# Path to SQL migration files relative to services/inbox-server/.
MIGRATIONS_DIR=../inbox/migrations
