{
  "name": "@emailflare/email-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, Zod schemas, and pure helpers for email-worker (CF) and email-server (Node.js)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "nanoid": "^5.1.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "typescript": "^5.8.3"
  }
}
