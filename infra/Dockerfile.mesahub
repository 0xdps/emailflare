# Builds a standalone mesahub-server image for local dev (embedded mode).
# The start-mesahub.sh wrapper starts the server, waits for it, then creates
# the application database before signalling ready.

FROM golang:1.24-alpine AS build
RUN apk add --no-cache gcc musl-dev sqlite-dev git

ARG MESAHUB_CORE_VERSION=trunk
RUN git clone --depth 1 --branch ${MESAHUB_CORE_VERSION} \
    https://github.com/mesahub-db/mesahub-core.git /mesahub-core
WORKDIR /mesahub-core/server
RUN CGO_ENABLED=1 GOOS=linux go build -o /usr/local/bin/mesahub-server ./cmd/server

FROM alpine:3.24
RUN apk add --no-cache ca-certificates curl sqlite-libs

COPY --from=build /usr/local/bin/mesahub-server /usr/local/bin/mesahub-server
COPY start-mesahub.sh /start.sh
RUN chmod +x /start.sh

VOLUME /data
EXPOSE 3002

HEALTHCHECK --interval=5s --timeout=3s --start-period=30s \
  CMD curl -sf http://localhost:3002/api/health || exit 1

ENTRYPOINT ["/start.sh"]
