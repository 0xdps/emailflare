:80 {
  @health path /health
  handle @health {
    reverse_proxy email-server:3000
  }

  @api path /api/* /v1/*
  handle @api {
    reverse_proxy email-server:3000
  }

  handle {
    # Vite dev server in dev compose
    reverse_proxy email-ui:5173
  }

  log {
    output stdout
    format console
  }
}
